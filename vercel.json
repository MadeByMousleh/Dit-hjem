{
  "buildCommand": "node scripts/build-public-site.mjs",
  "outputDirectory": "web-build/huslyg-public",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/energy/vault?job=spot-history&mode=forecast-capture",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/energy/vault?job=spot-history&mode=forecast-retry",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/energy/vault?job=spot-history&mode=recent",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/energy/vault?job=spot-history&mode=recent&retry=1",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/energy/vault?job=spot-history&mode=history",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/onboarding",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/elpriser.html",
      "destination": "/api/grid/lookup?operation=public-page"
    },
    {
      "source": "/callback",
      "destination": "/api/tesla/callback"
    }
  ],
  "functions": {
    "api/grid/lookup.mjs": {
      "maxDuration": 60,
      "includeFiles": "public/elpriser.html"
    },
    "api/address/search.mjs": {
      "maxDuration": 60
    },
    "api/energy/vault.mjs": {
      "maxDuration": 60
    },
    "api/eloverblik/usage.mjs": {
      "maxDuration": 60
    },
    "api/**/*.mjs": {
      "maxDuration": 30
    }
  }
}
