{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-pem-file"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/api/tesla/callback"
    }
  ],
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 30
    }
  }
}