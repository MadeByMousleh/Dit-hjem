{
  "name": "dit-hjem",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "db:login": "node --env-file-if-exists=.env scripts/supabase.mjs login",
    "db:link": "node --env-file-if-exists=.env scripts/supabase.mjs link",
    "db:new": "node --env-file-if-exists=.env scripts/supabase.mjs new",
    "db:status": "node --env-file-if-exists=.env scripts/supabase.mjs status",
    "db:plan": "node --env-file-if-exists=.env scripts/supabase.mjs plan",
    "db:migrate": "node --env-file-if-exists=.env scripts/supabase.mjs apply",
    "start": "expo start",
    "start:dev": "node scripts/start-expo-environment.mjs dev",
    "start:prod": "node scripts/start-expo-environment.mjs prod",
    "server": "node --env-file-if-exists=.env server.mjs",
    "tesla:register": "node --env-file-if-exists=.env scripts/register-tesla.mjs",
    "tesla:health": "node --env-file-if-exists=.env scripts/check-tesla-endpoints.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@noble/ciphers": "2.4.0",
