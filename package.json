    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/server": "^1.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/three": "^0.186.0",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
