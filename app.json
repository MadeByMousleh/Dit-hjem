{
  "expo": {
    "name": "Strømblik",
    "slug": "stromblik",
    "scheme": "stromblik",
    "version": "1.0.7",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/stromblik-app-icon.png",
    "splash": {
      "image": "./assets/brand/stromblik-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.dithjem.stromblik"
    },
    "android": {
      "versionCode": 8,
      "package": "dk.dithjem.stromblik",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/stromblik-adaptive-foreground.png",
        "backgroundColor": "#F5F5F2"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/stromblik-app-icon.png"
    },
    "plugins": [
      "expo-notifications",
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": "Brug Face ID til at låse dine krypterede eldata op." }]
    ]
  }
}
