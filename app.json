{
  "expo": {
    "name": "Strømblik",
    "slug": "stromblik",
    "scheme": "stromblik",
    "version": "1.0.48",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/stromblik-app-icon.png",
    "splash": {
      "image": "./assets/brand/stromblik-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.dithjem.stromblik"
    },
    "android": {
      "versionCode": 49,
      "package": "dk.dithjem.stromblik",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          { "scheme": "https", "host": "huslyg.dk", "pathPrefix": "/eloverblik/return.html" },
          { "scheme": "https", "host": "dit-hjem-five.vercel.app", "pathPrefix": "/eloverblik/return.html" }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/stromblik-adaptive-foreground.png",
        "backgroundColor": "#F5F5F2"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/stromblik-app-icon.png"
    },
    "plugins": [
      "expo-notifications",
      ["expo-image-picker", { "photosPermission": "Vælg billeder af dit hus til billedguiden.", "cameraPermission": "Tag billeder af de markerede facader på dit hus.", "microphonePermission": false }],
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": "Brug Face ID til at låse dine krypterede eldata op." }]
    ]
  }
}
